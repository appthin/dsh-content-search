{
  "name": "dsh-content-search",
  "version": "1.0.0",
  "type": "module",
  "description": "Search the current conversation — the loaded window or the whole history — highlight every keyword in yellow, and jump to a match.",
  "license": "MIT",
  "author": "appthin (https://github.com/appthin)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/appthin/dsh-content-search.git"
  },
  "homepage": "https://github.com/appthin/dsh-content-search#readme",
  "bugs": {
    "url": "https://github.com/appthin/dsh-content-search/issues"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "CHANGELOG.en.md",
    "screenshots.json",
    "screenshot*.png",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "search",
    "conversation",
    "highlight"
  ],
  "engines": {
    "dsh": ">=0.1.6-alpha.1 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.6-alpha.1 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
